# recorder — copy to .env and adjust. .env is git-ignored; this file is the contract.
# Loaded by `just dev` / `pnpm run start` via node --env-file-if-exists=.env.
# A variable already exported in the shell wins over the value set here.

# REQUIRED. Absolute path where the encoder writes the .ts segments and the playlist.
# There is no default: startup fails with a non-zero exit code when it is unset or empty.
# In production this is /var/lib/vigia/cameraA; in the devcontainer /var/lib is root-owned,
# so point it somewhere writable:
RECORDING_DIR=/workspace/recorder/.recordings/cameraA

# REQUIRED. Full rtsp:// URL of the camera, credentials included — the camera answers
# 401 Unauthorized to an anonymous DESCRIBE. Never commit the real credentials.
# Escape reserved characters in the password (@ -> %40, : -> %3A, / -> %2F).
RTSP_URL=rtsp://user:password@192.168.1.3:554/onvif1

# REQUIRED. Length of each .ts segment, as a positive integer number of seconds.
# 600 is the production value; lower it while debugging to see segments close sooner.
SEGMENT_DURATION_SECONDS=600
