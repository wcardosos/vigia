# recorder — module verbs. Working directory: recorder/.

# List the available verbs.
default:
    @just --list

# Full check: lint → types → architecture boundaries → forbidden vocabulary.
check:
    pnpm exec eslint .
    pnpm exec tsc --noEmit
    pnpm exec depcruise src
    ! grep -rniE 'ffmpeg' src/domain src/application 2>/dev/null

# Install module dependencies (frozen: fails if lockfile is out of date).
install:
    pnpm install --frozen-lockfile

# Every test: unit → integration → e2e.
test:
    pnpm exec vitest run

# Fast feedback: in-memory tests only, no filesystem and no child processes.
test-unit:
    pnpm exec vitest run tests/unit

# Tests that touch the real filesystem.
test-integration:
    pnpm exec vitest run tests/integration

# Tests that spawn the recorder as a real process.
test-e2e:
    pnpm exec vitest run tests/e2e

# Formatting (Prettier).
format:
    pnpm exec prettier --write .

# Local run via tsx. Reads .env; prefix to override, e.g. VIGIA_RECORDING_DIR=/tmp/rec just dev.
dev:
    pnpm run start
